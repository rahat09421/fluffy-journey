# StoreForge AI Environment Variables

# Database (Optional - for future integration)
# DATABASE_URL=postgresql://user:password@localhost:5432/storeforge
# or
# DATABASE_URL=mongodb://localhost:27017/storeforge

# AI Integration (Optional - for future OpenAI/Claude integration)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Authentication (Optional - for future NextAuth integration)
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=http://localhost:3000

# Payment Processing (Optional - for future Stripe integration)
# STRIPE_PUBLIC_KEY=pk_...
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Email Service (Optional - for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-password

# Application Settings
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SUBDOMAIN_SUFFIX=.storeforge.ai
